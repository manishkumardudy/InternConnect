PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/internshala_clone?retryWrites=true&w=majority
JWT_SECRET=supersecretjwtkey_internconnect_2026
JWT_REFRESH_SECRET=supersecretrefreshkey_internconnect_2026
NODE_ENV=development

# SMTP Email Credentials (Brevo / Sendinblue)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_login_email
SMTP_PASS=your_brevo_smtp_key
SMTP_FROM=your_verified_sender_email

# Razorpay Payment Gateway Configuration
# -------------------------------------------------------------
# For REAL Razorpay Test Mode (Official Razorpay Checkout Popup):
# 1. Set MOCK_PAYMENTS=false
# 2. Add your Razorpay Test Key ID (starts with rzp_test_...)
# 3. Add your Razorpay Test Key Secret
# 
# For Mock Payment Modal (Simulated QR / UTR Flow):
# Set MOCK_PAYMENTS=true or leave keys as default placeholders.
MOCK_PAYMENTS=false
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Test Override for 10:00 AM - 11:00 AM IST Payment Window (Set to true to test anytime)
DISABLE_TIME_WINDOW=false
